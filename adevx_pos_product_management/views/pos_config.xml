<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_inherit_pos_config_form" model="ir.ui.view">
            <field name="name">view.inherit.pos.config.form</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet/div[4]/div" position="before">
                    <group name="products" string="Products">
                        <group name="products_left">
                            <field name="limit_products_loading"/>
                            <field name="limit_products_loading_count" invisible="not limit_products_loading"/>
                            <field name="allow_order_out_of_stock"/>
                            <field name="is_margins_costs_accessible_to_every_user"/>
                        </group>
                        <group name="products_right">
                            <field name="display_onhand"/>
                            <field name="show_multi_location_info"/>
                            <field name="update_stock_onhand" invisible="not display_onhand" readonly="1"/>
                            <field name="multi_location" invisible="not display_onhand or not update_stock_onhand"/>
                            <field name="stock_location_ids" widget="many2many_tags"
                                   invisible="not display_onhand or not update_stock_onhand or not multi_location"/>
                        </group>

                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
