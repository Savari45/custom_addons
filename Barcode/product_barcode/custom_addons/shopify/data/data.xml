<odoo>
    <data noupdate="0">

        <!--            Export Stocks-->

        <record id="ir_cron_export_shopify_stock" model="ir.cron">
            <field name="name">Export Shopify Stock Every 2 Minutes</field>
            <field name="model_id" ref="model_shopify_stock_export"/>
            <field name="state">code</field>
            <field name="code">model.export_stock_to_shopify()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

        <record id="ir_cron_push_payments_to_shopify" model="ir.cron">
            <field name="name">Push Paid Invoices to Shopify</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.cron_push_payments_to_shopify()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>


        <record id="ir_cron_import_shopify_orders" model="ir.cron">
            <field name="name">Import Shopify Orders</field>
            <field name="model_id" ref="model_shopify_order_import"/>
            <field name="state">code</field>
            <field name="code">model.import_shopify_orders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_import_paid_shopify_orders" model="ir.cron">
            <field name="name">Import Paid/Partial Shopify Orders</field>
            <field name="model_id" ref="model_shopify_sale_paid_order"/>
            <field name="state">code</field>
            <field name="code">model.import_paid_shopify_sale_orders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>


        <!--        <record id="ir_cron_shopify_return_sync" model="ir.cron">-->
        <!--            <field name="name">Shopify Return Sync (Every Minute)</field>-->
        <!--            <field name="model_id" ref="stock.model_stock_picking"/>-->
        <!--            <field name="state">code</field>-->
