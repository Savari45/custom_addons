        <!--            <field name="interval_number">1</field>-->
        <!--            <field name="interval_type">minutes</field>-->
        <!--            <field name="numbercall">-1</field>-->
        <!--            <field name="active" eval="True"/>-->
        <!--        </record>-->

        <record id="ir_cron_push_products_to_shopify" model="ir.cron">
            <field name="name">Export Products to Shopify</field>
            <field name="model_id" ref="model_shopify_product_export"/>
            <field name="state">code</field>
            <field name="code">model.push_products_to_shopify()</field>
            <field name="interval_number">1</field> <!-- Runs every interval -->
            <field name="interval_type">minutes</field> <!-- minutes, hours, days, etc -->
            <field name="numbercall">-1</field> <!-- Unlimited executions -->
            <field name="active">True</field>
        </record>

        <record id="ir_cron_shopify_poll_returns_refunds" model="ir.cron">
            <field name="name">Shopify Poll Returns/Refunds</field>
            <field name="model_id" ref="model_shopify_sale_sync"/>
            <field name="state">code</field>
            <field name="code">model.poll_shopify_and_sync_refunds()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall">False</field>
        </record>


    </data>
</odoo>
