<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mrp_production_form_reverse" model="ir.ui.view">
        <field name="name">mrp.production.form.reverse</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_reverse_production" type="object"
                        string="Reverse Production"
                        class="btn-danger"
                        invisible="1 if state != 'done' else 0"/>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>

        </field>
    </record>
</odoo>
