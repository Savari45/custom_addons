<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Add this in your custom module’s XML under sale.order.line tree view -->
        <record id="view_order_form_shopify_line_id" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.shopify_line_id</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                    <field name="shopify_line_id"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>