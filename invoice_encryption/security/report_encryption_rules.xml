<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="report_encryption_user_rule" model="ir.rule">
        <field name="name">Access Report Encryption for Authorized Users</field>
        <field name="model_id" ref="invoice_encryption.model_report_encryption"/>
       <field name="domain_force">
           [('id', '!=', False)]
        </field>
        <field name="groups" eval="[(4, ref('invoice_encryption.group_can_view_encryption'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
