<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
   <t t-name="custom_pos_receipt.OrderReceipt"
      t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="inside">
            <t t-if="props.data.headerData.signature_code">
                <div class="pos-receipt-signature"
                     style="margin: 10px 0; padding: 8px; border-top: 1px dashed #000; border-bottom: 1px dashed #000;">
                    <strong>Signature Code:</strong>
                    <span t-esc="props.data.headerData.signature_code"/>
                </div>
            </t>
        </xpath>
   </t>
</templates>
