<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="dashboard_chart_view_list" model="ir.ui.view">
            <field name="name">dashboard_chart_view_list</field>
            <field name="model">dashboard.chart</field>
            <field name="arch" type="xml">
                <list string="dashboard_chart_list">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="dashboard_chart_view_form" model="ir.ui.view">
            <field name="name">dashboard_chart_view_form</field>
            <field name="model">dashboard.chart</field>
            <field name="arch" type="xml">
                <form string="dashboard_chart_form">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="type" required="1"/>
                                <field name="model_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}" invisible="use_sql"/>
                                <field name="model_name" invisible="1"/>
                                <field name="dashboard_id" invisible="1"/>
                                <field name="use_sql"/>
                                <br/>
                            </group>
                            <group>
                                <field name="preview_data" widget="dashbaord_maker_chart_preview" nolabel="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page invisible="not use_sql" string="Data to display">
                                <group>
                                    <field name="sql_bar_type" invisible="type not in ['bar', 'line', 'h_bar', 'area']"/>
                                    <field name="input_query"/>
                                </group>
                                <group string="Date Filters configuration" invisible="type=='hierarchy'">
                                    <group>
                                        <field name="date_filter_default" options='{"no_create": True, "no_open": True}'/>
                                    </group>
                                    <group>
                                        <field name="custom_datetime_start"/>
                                        <field name="custom_datetime_end"/>
                                    </group>
                                </group>
                            </page>
                            <page name="display_fields" string="Data to display" invisible="use_sql">
                                <group invisible="type not in ['bar', 'line', 'pie', 'doughnut', 'h_bar', 'funnel', 'h_doughnut', 'h_pie', 'area']">
                                    <group string="Group by field data">
                                        <field name="group_field_id" options='{"no_create": True, "no_open": True}'/>
                                        <field name="group_field_type" invisible="1"/>
                                        <field name="group_date_aggregates" invisible="group_field_type not in ['date', 'datetime']"/>
                                    </group>
                                    <group invisible="type in ['pie', 'hierarchy', 'funnel', 'doughnut', 'h_doughnut', 'h_pie']" string="Sub group by field data">
                                        <field name="sub_group_field_id" options='{"no_create": True, "no_open": True}'/>
                                        <field name="sub_group_field_type" invisible="1"/>
                                        <field name="sub_group_date_aggregates" invisible="sub_group_field_type not in ['date', 'datetime']"/>
                                    </group>
                                </group>
                                <group invisible="type not in ['scatter']">
                                    <group>
                                        <field name="scatter_x"/>
                                    </group>
                                    <group>
                                        <field name="scatter_y"/>
                                        <field name="scatter_y_type" invisible="1"/>
                                        <field name="scatter_y_agg"/>
                                    </group>
                                </group>

                                <group invisible="type not in ['card', 'funnel']">
                                    <group>
                                        <field name="display_field_id" options='{"no_create": True, "no_open": True}'/>
                                        <field name="display_field_type" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="display_field_agg" options='{"no_create": True, "no_open": True}'/>
                                    </group>
                                </group>
<!--                                <group invisible="type!='hierarchy'">-->
<!--                                    <group>-->
<!--                                        <field name="hierarchy_data_field" options='{"no_create": True, "no_open": True}'/>-->
<!--                                    </group>-->
<!--                                </group>-->
                                <group string="Fields to display data" invisible="type in ['scatter', 'hierarchy', 'funnel', 'card']">
                                    <field name="display_field_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="chart_id" column_invisible="1"/>
                                            <field name="model_id" column_invisible="1"/>
                                            <field name="list_grouped" column_invisible="1"/>
                                            <field name="field_type" column_invisible="1"/>
                                            <field name="field_id" required="1" options='{"no_create": True, "no_open": True}'/>
                                            <field name="field_aggregation_id" readonly="list_grouped" required="not list_grouped" options='{"no_create": True, "no_open": True}'/>
                                            <field name="name" required="1"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Group by fields" invisible="type != 'list' or (type=='funnel')">
                                    <field name="group_field_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="chart_id" column_invisible="1"/>
                                            <field name="model_id" column_invisible="1"/>
                                            <field name="field_type" column_invisible="1"/>
                                            <field name="field_id" options='{"no_create": True, "no_open": True}'/>
                                            <field name="date_aggregates" required="field_type in ['date', 'datetime']" readonly="field_type not in ['date', 'datetime']" options='{"no_create": True, "no_open": True}'/>
                                            <field name="display_string"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Sort Order Configuration" invisible="type in ['card', 'hierarchy', 'funnel']">
                                    <field name="sort_field_ids" nolabel="1">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="model_id" column_invisible="1"/>
                                            <field name="chart_id" column_invisible="1"/>
                                            <field name="field_id" required="1" options='{"no_create": True, "no_open": True}'/>
                                            <field name="sort_type" required="1"/>
                                        </list>
                                    </field>
                                </group>

                                <group string="Date Filters configuration" invisible="type=='hierarchy'">
                                    <group>
                                        <field name="datetime_filter_field" options='{"no_create": True, "no_open": True}'/>
                                        <field name="date_filter_default" options='{"no_create": True, "no_open": True}'/>
                                    </group>
                                    <group>
                                        <field name="custom_datetime_start"/>
                                        <field name="custom_datetime_end"/>
                                    </group>
                                </group>
                            </page>

                            <page string="Display options" invisible="type!='card'">
                                <group>
                                    <group>
                                        <field name="card_format" required="type=='card'"/>
                                    </group>
                                    <group>
                                        <field name="bg_color" widget="color"/>
                                        <field name="title_color" widget="color"/>
                                        <field name="value_color" widget="color"/>
                                        <field name="border_color" widget="color"/>
                                    </group>
                                </group>
                            </page>


                            <page string="Data options" invisible="type=='hierarchy'">
                                <group>
                                    <group>
                                        <field name="fields_stacked" invisible="type not in ['bar', 'line', 'h_bar']"/>
                                        <field name="groups_stacked" invisible="type not in ['bar', 'line', 'h_bar']"/>
                                        <field name="number_system_id" options='{"no_create": True, "no_open": True}'/>
                                        <field name="list_view_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                        <field name="form_view_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                    </group>
                                    <group>
                                        <field name="data_limit" invisible="type!='list'" required="type=='list'"/>
                                        <field name="records_limit" invisible="type in ['card', 'hierarchy']"/>
                                        <field name="override_custom_datefilter" invisible="type=='hierarchy'"/>
                                        <field name="show_records"/>
                                    </group>
                                </group>
                            </page>
                             <page string="Chart Options" invisible="type in ['card', 'list', 'hierarchy']">
                                 <group>
                                     <group>
                                         <field name="color_palette_id" options="{'no_edit': True, 'no_create': True}"/>
                                         <field name="step_line" invisible="type not in ['line', 'area']"/>
                                         <field name="step_position" invisible="type not in ['line', 'area'] or not step_line"/>
                                         <field name="smooth_line" invisible="type not in ['line', 'area']"/>
                                     </group>
                                     <group>
                                         <field name="display_data_value"/>
                                         <field name="pie_label_format" invisible="type not in ['pie', 'h_pie', 'doughnut', 'h_doughnut']"/>
                                        <field name="enable_zoom" invisible="type not in ['bar', 'line', 'h_bar', 'area']"/>
                                     </group>
                                 </group>
                            </page>
                            <page string="Data Access">
                                <field name="data_filter_ids" widget="one2many">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="chart_id" column_invisible="1"/>
                                        <field name="model_name" column_invisible="1"/>
                                        <field name="model_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                        <field name="domain" widget="domain" options="{'model': 'model_name', 'in_dialog': True, 'allow_expressions': True}"/>
                                        <field name="group_ids" widget="many2many_tags" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                    </list>
                                </field>
                            </page>
                            <page name="filters_mapping" string="Filter mapping">
                                <field name="filter_mapping_ids" widget="one2many">
                                    <list editable="bottom">
                                        <field name="chart_id" column_invisible="1"/>
                                        <field name="chart_model_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                        <field name="dashboard_filters_ids" column_invisible="1"/>
                                        <field name="filter_id" required="1" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                        <field name="field_ids" widget="many2many_tags" required="1" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</odoo>