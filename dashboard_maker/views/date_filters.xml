<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="date_filters_view_list" model="ir.ui.view">
            <field name="name">date_filters_view_list</field>
            <field name="model">date.filters</field>
            <field name="arch" type="xml">
                <list string="date_filters_view_list" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name" required="1"/>
                    <field name="apply_type" required="1"/>
                    <field name="period"/>
                     <field name="start"/>
                    <field name="end"/>
                    <field name="custom_start"/>
                    <field name="custom_end"/>
                    <field name="dashboard_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="date_filters_action" model="ir.actions.act_window">
            <field name="name">Date Filters</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">date.filters</field>
            <field name="view_mode">list</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="date_filters_action_menu" parent="dashboard_maker_config_menu" action="date_filters_action" />

    </data>
</odoo>