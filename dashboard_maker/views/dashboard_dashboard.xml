<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
         <record id="dashboard_maker_view_form" model="ir.ui.view">
            <field name="name">dashboard_view_form</field>
            <field name="model">dashboard.dashboard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                         <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="action_name" required="1"/>
                                <field name="is_active"/>
                            </group>
                            <group>
                                <field name="parent_menu_id" options='{"no_open": True, "no_create": True}'/>
                                <field name="sequence"/>
                                <field name="menu_icon"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Filters configuration">
                                <field name="filter_models_ids">
                                    <list editable="bottom">
                                        <field name="model_id" options='{"no_open": True, "no_create": True}' required="1"/>
                                        <field name="field_ids" widget="many2many_tags" options='{"no_open": True, "no_create": True}' required="1"/>
                                        <field name="dashboard_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                            <page name="access_groups" string="Visibility">
                                <field name="group_ids">
                                    <list create="0" edit="0" delete="0" duplicate="0" editable="bottom">
                                        <field name="full_name"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Advanced Configurations">
                                <group>
                                    <group>
                                        <field name="date_filter_default" options='{"no_open": True, "no_create": True}'/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="dashboard_maker_all_dashboards_view_list" model="ir.ui.view">
            <field name="name">dashboard_maker_all_dashboards_view_list</field>
            <field name="model">dashboard.dashboard</field>
            <field name="arch" type="xml">
                <list string="dashboard_dashboard_menus_view_list">
                    <field name="priority" widget="priority"/>
                    <field name="name"/>
                    <field name="parent_menu_id"/>
                    <field name="group_ids" widget="many2many_tags"/>
                    <field name="is_active"/>
                    <button name="open_dashboard_preview" type="object" string="Open Dashboard"/>
                    <button name="open_dashboard_items" type="object" string="View Charts"/>
                </list>
            </field>
        </record>

        <record id="dashboards_configuration_all_menu_action" model="ir.actions.act_window">
            <field name="name">All Dashboards</field>
            <field name="res_model">dashboard.dashboard</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('dashboard_maker_all_dashboards_view_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('dashboard_maker_view_form')}),
        ]"/>
        </record>

        <menuitem id="dashboard_maker_dashboards_menu" name="Dashboards" parent="dashboard_maker_main_menu" sequence="-2" action="dashboards_configuration_all_menu_action" groups="dashboard_maker.group_dashboard_maker_admin"/>

    </data>

</odoo>