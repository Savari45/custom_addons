<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="number_system_view_list" model="ir.ui.view">
            <field name="name">number_system_view_list</field>
            <field name="model">number.system</field>
            <field name="arch" type="xml">
                <list string="number_system_list">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="number_system_view_form" model="ir.ui.view">
            <field name="name">number_syste,_view_form</field>
            <field name="model">number.system</field>
            <field name="arch" type="xml">
                <form string="number_syste,_form">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                        <notebook>
                            <page name="line_ids" string="Number System Lines">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="no_of_digits"/>
                                        <field name="display_notation"/>
                                        <field name="number_system_id" column_invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="number_system_action" model="ir.actions.act_window">
            <field name="name">Number Systems</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">number.system</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="number_system_action_menu" parent="dashboard_maker_config_menu" action="number_system_action"/>

    </data>
</odoo>