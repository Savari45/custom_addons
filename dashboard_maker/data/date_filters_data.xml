<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="filter_today" model="date.filters">
            <field name="name">Today</field>
            <field name="period">days</field>
            <field name="apply_type">start_end_at</field>
        </record>

        <record id="filter_current_week" model="date.filters">
            <field name="name">This Week</field>
            <field name="period">weeks</field>
            <field name="apply_type">start_end_at</field>
        </record>

        <record id="filter_current_month" model="date.filters">
            <field name="name">This Month</field>
            <field name="period">months</field>
            <field name="apply_type">start_end_at</field>
        </record>

        <record id="filter_current_year" model="date.filters">
            <field name="name">This Year</field>
            <field name="period">years</field>
            <field name="apply_type">start_end_at</field>
        </record>

        <record id="filter_tomorrow" model="date.filters">
            <field name="name">Tomorrow</field>
            <field name="period">days</field>
            <field name="apply_type">start_end_at</field>
            <field name="start">1</field>
            <field name="end">1</field>
        </record>

        <record id="filter_next_week" model="date.filters">
            <field name="name">Next Week</field>
            <field name="period">weeks</field>
            <field name="apply_type">start_end_at</field>
            <field name="start">1</field>
            <field name="end">1</field>
        </record>

        <record id="filter_next_month" model="date.filters">
            <field name="name">Next Month</field>
            <field name="period">months</field>
            <field name="apply_type">start_end_at</field>
            <field name="start">1</field>
            <field name="end">1</field>
        </record>

        <record id="filter_next_year" model="date.filters">
            <field name="name">Next Year</field>
            <field name="period">years</field>
            <field name="apply_type">start_end_at</field>
            <field name="start">1</field>
            <field name="end">1</field>
        </record>

    </data>
</odoo>