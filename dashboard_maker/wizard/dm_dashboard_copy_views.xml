<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="copy_chart_view_form" model="ir.ui.view">
            <field name="name">copy_chart_view_form</field>
            <field name="model">copy.dashboard.chart.wizard</field>
            <field name="arch" type="xml">
                <form string="color_palette_form">
                    <sheet>
                        <group>
                            <group>
                                <field name="dashboard_id" options="{'no_edit': True, 'no_create': True, 'no_open': True}"/>
                                <field name="operation" invisible="1"/>
                                <field name="chart_id" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_copy_chart" string="Apply" type="object" class="btn-primary" data-hotkey="q"/>
                        <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>