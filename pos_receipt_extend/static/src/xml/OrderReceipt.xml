<?xml version="1.0" encoding="UTF-8"?>
<!--To add the customer details in the settings page-->
<templates id="template" xml:space="preserve">
    <t t-name="OrderReceipt" t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension" owl="1">
        <xpath expr="//h1[hasclass('tracking-number')]" position="replace">
        </xpath>
        <xpath expr="//div/span[hasclass('tracking-number')]" position="replace">
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="inside">

            <t t-if="this.env.services.pos.config.customer_details">
                  <div t-if="this.env.services.pos.config.invoice_no and this.props.data.invoice_no"
                       style="font-weight: 600; font-size: 16px;">Invoice:<t
                          t-esc="this.props.data.invoice_no"/>
                      <br></br>
                </div>
                <div t-if="this.env.services.pos.config.customer_name and this.props.data.customer_name"
                > customer:<t
                        t-esc="this.props.data.customer_name"/>
                </div>
                <div t-if="this.env.services.pos.config.customer_address and this.props.data.customer_address"
                > Address:<t
                        t-esc="this.props.data.customer_address"/>
                </div>
                <div t-if="this.env.services.pos.config.customer_mobile and this.props.data.customer_mobile"
                >Mobile:<t
                        t-esc="this.props.data.customer_mobile"/>
                </div>
                <div t-if="this.env.services.pos.config.customer_phone and this.props.data.customer_phone"
                >Phone:<t
                        t-esc="this.props.data.customer_phone"/>
                </div>
                <div t-if="this.env.services.pos.config.customer_email and this.props.data.customer_email"
                >Email:<t
                        t-esc="this.props.data.customer_email"/>
                </div>
                <div t-if="this.env.services.pos.config.customer_vat and this.props.data.customer_vat">
                    Vat:<t
                        t-esc="this.props.data.customer_vat"/>
                </div>

            </t>
        </xpath>
    </t>
    <t t-name="pos_receipt_extend.CustomOrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
    <xpath expr="//OrderWidget" position="replace">

        <table style="border-collapse: collapse; font-size: 14px; margin: auto; width: 100%;">
            <thead>
                <tr style="font-weight: 600; border-bottom: 1px solid black; border-top: 1px solid black; border-collapse: collapse;">
                    <th>Qty</th>
                    <th>Product</th>
                    <th>Unit</th>
                    <th>Subt</th>
                    <th>Tax</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="props.data.orderlines" t-as="line" t-key="line.id || loop.index" style="font-weight: normal;">
                    <td style="padding: 2px;">
                        <t t-esc="line.quantity"/>
                    </td>
                    <td style="padding: 2px;">
                        <t t-esc="line.product_name"/>
                    </td>
                    <td style="padding: 2px;">
                        <t t-esc="line.price"/>
                    </td>
                    <td style="padding: 2px;">
                        <t t-esc="line.line_total"/>
                    </td>
                    <td style="padding: 2px;">
                        <t t-if="line.line_taxes and line.line_taxes.length > 0">
                            <t t-foreach="line.line_taxes" t-as="tax" t-key="tax.name">
                                <div>
                                    <t t-esc="tax.name"/>
                                </div>
                            </t>
                        </t>
                        <t t-else="">No Tax</t>
                    </td>
                </tr>
            </tbody>
        </table>
    </xpath>
          <xpath expr="//div[hasclass('after-footer')]" position="after">
              <div>-------------------------------------</div>
               <div class="signature-code" t-if="props.data.headerData.signature_code">
                 <t t-esc="props.data.headerData.signature_code"/>
        </div>
          </xpath>
</t>

</templates>


