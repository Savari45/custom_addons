<odoo>
  <record id="view_invoice_report_wizard_form" model="ir.ui.view">
    <field name="name">invoice.report.wizard.form</field>
    <field name="model">sales.invoice.report.wizard</field>
    <field name="arch" type="xml">
      <form string="Sales Invoice Report">
        <group>
          <field name="date_from"/>
          <field name="date_to"/>
          <field name="partner_id"/>
          <field name="state"/>
        </group>
        <footer>
          <button string="Print PDF" type="object" name="action_print_report" class="btn-primary"/>
          <button string="Cancel" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_invoice_report_wizard" model="ir.actions.act_window">
    <field name="name">Sales Invoice Report</field>
    <field name="res_model">sales.invoice.report.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
