<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="inv">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Invoice: <t t-esc="inv.name"/></h2>
                        <p><strong>Date:</strong> <t t-esc="inv.invoice_date"/></p>
                        <p><strong>Customer:</strong> <t t-esc="inv.partner_id.name"/></p>
                        <p><strong>Due Date:</strong> <t t-esc="inv.invoice_date_due"/></p>

                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th>Qty</th>
                                    <th>Unit Price</th>
                                    <th>Disc.</th>
                                    <th>Tax</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="inv.invoice_line_ids" t-as="line">
                                    <td><t t-esc="line.name"/></td>
                                    <td><t t-esc="line.quantity"/></td>
                                    <td><t t-esc="line.price_unit"/></td>
                                    <td><t t-esc="line.discount"/>%</td>
                                    <td>
                                        <t t-esc="', '.join([t.name for t in line.tax_ids])"/>
                                    </td>
                                    <td><t t-esc="line.price_subtotal"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <p><strong>Subtotal:</strong> <t t-esc="inv.amount_untaxed"/></p>
                        <p><strong>Tax:</strong> <t t-esc="inv.amount_tax"/></p>
                        <p><strong>Total:</strong> <t t-esc="inv.amount_total"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
